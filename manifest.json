{
  "manifest_version": 3,
  "name": "XHS Creator Analytics",
  "short_name": "XHS Analytics",
  "version": "1.0.0",
  "description": "在小红书创作服务平台本地汇总笔记数据并导出分析结果。",
  "permissions": ["activeTab"],
  "host_permissions": ["https://creator.xiaohongshu.com/*"],
  "action": {
    "default_title": "XHS Creator Analytics",
    "default_popup": "popup.html",
    "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "content_scripts": [
    {
      "matches": ["https://creator.xiaohongshu.com/new/note-manager*"],
      "js": ["xlsx-export.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/new/note-manager*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
